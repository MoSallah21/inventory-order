# Local Docker PostgreSQL settings. Supply local-only values in .env.
POSTGRES_DB="inventory"
POSTGRES_USER="inventory_local"
POSTGRES_PASSWORD="replace-with-a-local-only-password"
POSTGRES_PORT="5432"

# PostgreSQL connection used by the application and Prisma CLI.
DATABASE_URL="postgresql://inventory_local:replace-with-a-local-only-password@localhost:5432/inventory?schema=public"

# Generate with: openssl rand -base64 32
# Never use this example value outside local setup.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Set to true only when intentionally loading documented demo data.
SEED_DEMO_DATA="false"

# Required in production for supplier product-image upload and deletion.
# Keep the API secret server-only; never use a NEXT_PUBLIC_ variable.
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"
